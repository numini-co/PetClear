{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd website && npm install",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/routes", "destination": "/routes/", "permanent": true },
    { "source": "/cities", "destination": "/cities/", "permanent": true },
    { "source": "/cities/dubai", "destination": "/dubai/", "permanent": true },
    { "source": "/cities/dubai/", "destination": "/dubai/", "permanent": true },
    { "source": "/dubai/karama", "destination": "/dubai/bur-dubai/", "permanent": true },
    { "source": "/dubai/karama/", "destination": "/dubai/bur-dubai/", "permanent": true },
    { "source": "/dubai/bluewaters", "destination": "/dubai/jbr/", "permanent": true },
    { "source": "/dubai/bluewaters/", "destination": "/dubai/jbr/", "permanent": true },
    { "source": "/dubai/port-de-la-mer", "destination": "/dubai/jumeirah/", "permanent": true },
    { "source": "/dubai/port-de-la-mer/", "destination": "/dubai/jumeirah/", "permanent": true },
    { "source": "/dubai/city-walk", "destination": "/dubai/downtown-dubai/", "permanent": true },
    { "source": "/dubai/city-walk/", "destination": "/dubai/downtown-dubai/", "permanent": true },
    { "source": "/dubai/international-city", "destination": "/dubai/dubai-silicon-oasis/", "permanent": true },
    { "source": "/dubai/international-city/", "destination": "/dubai/dubai-silicon-oasis/", "permanent": true },
    { "source": "/dubai/al-wasl", "destination": "/dubai/umm-suqeim/", "permanent": true },
    { "source": "/dubai/al-wasl/", "destination": "/dubai/umm-suqeim/", "permanent": true },
    { "source": "/dubai/sheikh-zayed-road", "destination": "/dubai/", "permanent": true },
    { "source": "/dubai/sheikh-zayed-road/", "destination": "/dubai/", "permanent": true }
  ],
  "rewrites": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Vary", "value": "Accept-Encoding, Accept-Language" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://web-grower.vercel.app; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://*.analytics.google.com https://web-grower.vercel.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, max-age=0, s-maxage=0, must-revalidate" }
      ]
    }
  ]
}
